~ > code condition ~ return(equals(get("char"), ">")) ~~
~ < code condition ~ return(equals(get("char"), "<")) ~~
~ + code condition ~ return(equals(get("char"), "+")) ~~
~ - code condition ~ return(equals(get("char"), "-")) ~~
~ . code condition ~ return(equals(get("char"), ".")) ~~
~ , code condition ~ return(equals(get("char"), ",")) ~~
~ [ code condition ~ return(equals(get("char"), "[")) ~~
~ ] code condition ~ return(equals(get("char"), "]")) ~~

~ / code condition ~ return(equals(get("char"), "/")) ~~
~ * code condition ~ return(equals(get("char"), "*")) ~~

~ [ code else ~ if(function("] code condition"), function("]")) ~~

~ code callback ~
run(function("next"))

if(function("> code condition"), function(">"))
if(function("< code condition"), function("<"))
if(function("+ code condition"), function("+"))
if(function("- code condition"), function("-"))
if(function(". code condition"), function("."))
if(function(", code condition"), function(","))
; need to be mutually exclusive since it changes i
if(function("[ code condition"), function("["), function("[ code else"))

if(function("/ code condition"), function("/"))
if(function("* code condition"), function("*"))
~~

